APP_NAME=CLINICSYNC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
# For MySQL (default):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinicsync
DB_USERNAME=root
DB_PASSWORD=

# For zero-config SQLite deployment:
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite
# DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# For production SMS processing without request latency, use 'database' or 'redis'
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# SMS Gateway Configuration
# Options: 'simulated' (logs messages to database for zero-cost demo), 'twilio', 'semaphore', 'custom_http'
SMS_GATEWAY_PROVIDER=simulated
SMS_SIMULATION_ENABLED=true
SMS_REMINDER_HOURS_BEFORE=24

# Twilio Credentials (when SMS_GATEWAY_PROVIDER=twilio)
SMS_TWILIO_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# Semaphore Credentials (when SMS_GATEWAY_PROVIDER=semaphore)
SMS_SEMAPHORE_API_KEY=
SMS_SEMAPHORE_SENDER_NAME=CLINICSYNC

# Custom HTTP SMS Gateway (when SMS_GATEWAY_PROVIDER=custom_http)
SMS_CUSTOM_HTTP_URL=
SMS_CUSTOM_HTTP_TOKEN=

# Shelex Free OTP & Inbound Test SMS Verification Service
# https://otp-api.shelex.dev/api/
SMS_FREE_OTP_API_URL=https://otp-api.shelex.dev/api

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@clinicsync.com"
MAIL_FROM_NAME="${APP_NAME}"
